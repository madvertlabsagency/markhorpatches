# ─────────────────────────────────────────────────────────────
# PATCH GORILLA — environment variables
# Copy to `.env` (local) and fill in. NEVER commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
# 32+ random bytes. Used to sign upload tokens, guest order links, etc.
# Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchgorilla

# Initial super admin (used by `npm run db:seed` only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# ── Payments ────────────────────────────────────────────────
# "stripe" | "mock" (mock is refused when NODE_ENV=production)
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: let Stripe compute sales tax at checkout
STRIPE_AUTOMATIC_TAX=false

# ── Object storage (artwork + proofs) ───────────────────────
# "local" (dev only, stores in ./.uploads) | "s3" (AWS S3, Cloudflare R2, MinIO, Backblaze B2…)
STORAGE_DRIVER=local
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS. Set for R2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Email ───────────────────────────────────────────────────
# "console" (logs only) | "resend" | "postmark"
EMAIL_PROVIDER=console
EMAIL_FROM="Patch Gorilla <hello@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Internal inbox that receives new-lead / revision notifications
OPS_NOTIFICATION_EMAIL=

# ── CRM: GoHighLevel (LeadConnector API v2) ─────────────────
# Leave empty to disable. The site keeps working if GHL is down.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
# Optional pipeline stage IDs (opportunity moves through these)
GHL_STAGE_NEW_LEAD=
GHL_STAGE_MOCKUP=
GHL_STAGE_PROOF_READY=
GHL_STAGE_APPROVED=
GHL_STAGE_WON=

# ── Cron / background jobs ──────────────────────────────────
# Bearer token required by /api/cron/* (CRM retry queue, abandoned carts)
CRON_SECRET=

# ── Analytics (all optional) ───────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Support ────────────────────────────────────────────────
# Fallbacks only — prefer editing these in /admin/settings.
# WhatsApp number in international format, digits only (e.g. 15551234567). Empty = button hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Integration tests (separate, disposable database)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchgorilla_test
