# ── Core (required) ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ≥32 random chars. Signs sessions/tokens and encrypts MFA secrets. Rotating it logs everyone out
# and invalidates enrolled TOTP secrets (users must re-enrol).
APP_SECRET=
# Postgres. POSTGRES_PRISMA_URL / POSTGRES_URL (optionally prefixed) are also accepted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchmatch
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patchmatch_test

# First super-admin created by `npm run db:seed` (idempotent). Enrol MFA on first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Enforced by default when NODE_ENV=production. Never set to false in production.
ADMIN_MFA_REQUIRED=

# ── Payments ──────────────────────────────────────────────────────
# sandbox | manual | safepay | payfast | faysal
#  sandbox: test-only hosted checkout + signed webhooks. Refused in production unless ALLOW_SANDBOX_PAYMENTS=true.
#  manual:  admin-issued invoices → prepaid credits after admin confirms receipt (works today).
#  safepay/payfast/faysal: adapters NOT integrated — they throw until merchant approval + API docs are obtained.
PAYMENTS_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=
SANDBOX_WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────────────────────────
# local (dev only) | s3 (any S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Name of a configured malware scanner. Unset = uploads are type/magic-byte validated only.
MALWARE_SCANNER=

# ── Email ─────────────────────────────────────────────────────────
# console (logs only) | resend | postmark
EMAIL_PROVIDER=console
EMAIL_FROM="PatchMatch AI <hello@example.com>"
EMAIL_REPLY_TO=
SUPPORT_EMAIL=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
OPS_ALERT_EMAILS=false

# ── AI ────────────────────────────────────────────────────────────
# rules (deterministic, default) | anthropic
AI_PROVIDER=rules
ANTHROPIC_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Jobs / cron ───────────────────────────────────────────────────
# Bearer token Vercel Cron (or your scheduler) sends to /api/cron/*.
CRON_SECRET=
# Set to false to disable the inline after-response queue kick.
JOBS_INLINE=

# ── Analytics (optional, consent-gated) ───────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Variable cost per sold RFQ (minor units) used in contribution metrics.
VARIABLE_COST_PER_SOLD_MINOR=200

# ── Demo (never in production DB) ─────────────────────────────────
DEMO_MODE=false
DEMO_PASSWORD=
