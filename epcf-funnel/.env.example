# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://epcf-funnel.vercel.app
# Only when served under a path of another domain (for example madvertlabs.com/epcf): /epcf
NEXT_PUBLIC_BASE_PATH=

# ---------- Supabase (database, private artwork storage, retry queue) ----------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose
SUPABASE_ARTWORK_BUCKET=rfq-artwork
ARTWORK_MAX_MB=25
NEXT_PUBLIC_ARTWORK_MAX_MB=25         # keep equal to ARTWORK_MAX_MB
ARTWORK_LINK_SECRET=                  # any random 32+ character string (signs artwork links)

# ---------- Owner ----------
ADMIN_PASSWORD=                       # password for /admin (12+ characters)
ADMIN_ALERT_EMAILS=                   # owner email(s), comma separated: new lead alerts and system alerts

# ---------- CRM ----------
CRM_PROVIDER=ghl                      # ghl, or none (Supabase + /admin only)
CUSTOMER_EMAIL_PROVIDER=ghl           # ghl (sent from the GHL conversation) or resend

# ---------- GoHighLevel (docs/GHL-WORKFLOWS.md, part A6) ----------
GHL_PRIVATE_INTEGRATION_TOKEN=        # scopes: contacts, opportunities, locations/customFields, conversations/message
GHL_LOCATION_ID=
GHL_PIPELINE_NAME=EPCF Sales Pipeline
GHL_STAGE_NAME=New RFQ
GHL_ROUND_ROBIN_USER_IDS=             # the owner's GHL user id (comma separate if you add salespeople later)
GHL_WEBHOOK_SECRET=                   # random string; used in the GHL "Customer Replied" webhook URL

# ---------- WhatsApp ----------
NEXT_PUBLIC_WHATSAPP_NUMBER=          # your WhatsApp Business number, digits with country code, e.g. YOUR_WHATSAPP_NUMBER
WHATSAPP_PROVIDER=ghl                 # ghl (number connected in GHL) or meta (WhatsApp Cloud API)
# Only when WHATSAPP_PROVIDER=meta:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_NUDGE_TEMPLATE=              # optional: approved template name for the 10 minute nudge, e.g. rfq_verify_nudge
WHATSAPP_TEMPLATE_LANG=en_US

# Optional fallback: code sent to the customer's WhatsApp by Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------- Meta Pixel + Conversions API ----------
NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID   # "Customers" dataset in the Markhor Patches business
META_CAPI_ACCESS_TOKEN=               # Events Manager > dataset > Settings > Generate access token
META_TEST_EVENT_CODE=                 # only while testing, then remove

# ---------- Funnel analytics and Meta Marketing API (docs/FUNNEL-ANALYTICS.md) ----------
META_SYSTEM_USER_TOKEN=               # server only: system user token with ads_read on the ad account
META_AD_ACCOUNT_ID=YOUR_AD_ACCOUNT_ID
META_GRAPH_VERSION=v24.0              # set to the latest stable Graph API version
FUNNEL_TIMEZONE=America/New_York      # business time zone for date ranges and hour of day
FUNNEL_CAMPAIGN_FILTER=Leadlink       # dashboard default: campaigns whose name contains this
NEXT_PUBLIC_ENGAGED_SECONDS=10        # seconds on page before the browser sends "engaged"

# ---------- Cloudflare Turnstile ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Email via Resend (optional with GHL: owner alert email and failure alerts) ----------
RESEND_API_KEY=
ALERT_FROM_EMAIL=EPCF <support@ep-cf.com>

# ---------- Vercel Cron ----------
CRON_SECRET=                          # random string; Vercel sends it to /api/cron/retry

# ---------- Copy and widgets ----------
NEXT_PUBLIC_PRODUCTION_TIME=          # e.g. "7 to 10 business days" (FAQ)
NEXT_PUBLIC_SHIPPING_TIME=            # e.g. "3 to 5 business days" (FAQ)
NEXT_PUBLIC_TRUSTPILOT_BUSINESSUNIT_ID=  # from Trustpilot TrustBox code; leave empty to show the designed rating block
